# MySQL connection. Create the database first (for example: threads_ai).
DATABASE_URL="mysql://threads_user:replace-with-password@127.0.0.1:3306/threads_ai"

# Gemini Developer API key from Google AI Studio.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# 32-byte base64 key for AES-256-GCM encrypted Threads access tokens.
THREADS_TOKEN_ENCRYPTION_KEY=""

# Secret bearer credential for a local cron/systemd timer calling the scheduler endpoint.
SCHEDULER_SECRET=""

# Single-owner dashboard login and signed session cookie.
APP_PASSWORD="replace-with-a-long-unique-password"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
